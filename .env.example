# Copie para .env: cp .env.example .env
# Valores alinhados ao docker-compose.yml (apps no host, bancos nos containers).
NODE_ENV=development

# accounts — porta publicada 5432
ACCOUNTS_PORT=3001
ACCOUNTS_DB_HOST=localhost
ACCOUNTS_DB_PORT=5432
ACCOUNTS_DB_USER=postgres
ACCOUNTS_DB_PASSWORD=postgrespassword
ACCOUNTS_DB_NAME=accounts_db
ACCOUNTS_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/accounts_db

# transactions — porta publicada 5433
TRANSACTIONS_PORT=3002
TRANSACTIONS_DB_HOST=localhost
TRANSACTIONS_DB_PORT=5433
TRANSACTIONS_DB_USER=postgres
TRANSACTIONS_DB_PASSWORD=postgrespassword
TRANSACTIONS_DB_NAME=transactions_db
TRANSACTIONS_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/transactions_db
