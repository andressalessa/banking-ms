{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@core": [
        "./libs/core/src/index.ts"
      ],
      "@core/*": [
        "./libs/core/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/accounts/tsconfig.app.json"
    },
    {
      "path": "./apps/transactions/tsconfig.app.json"
    },
    {
      "path": "./libs/core/tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
